  "dependencies": {
    "@holiday/spec": "workspace:*",
    "@holiday/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}

{
  "name": "@holiday/core",
  "version": "1.0.0",
  "description": "Holiday Data Platform — core runtime SDK for querying holiday data",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",

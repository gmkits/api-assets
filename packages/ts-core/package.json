    "test": "node --test dist/esm/__tests__/*.test.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@holiday/spec": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

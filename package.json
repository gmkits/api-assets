{
  "name": "api-assets",
  "version": "0.0.0",
  "private": true,
  "description": "Language-neutral monorepo for independently deployable API assets",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate:assets": "node tools/validate-assets.mjs",
    "lint:openapi": "redocly lint apis/*/contract/openapi.yaml",
    "build:calendar-compiler": "pnpm --filter @api-assets/calendar-compiler build",
    "test:calendar-compiler": "pnpm --filter @api-assets/calendar-compiler test",
    "lint:calendar-compiler": "pnpm --filter @api-assets/calendar-compiler lint"
  },
  "devDependencies": {
    "@redocly/cli": "2.40.0",
    "ajv": "8.17.1"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://holiday-platform.dev/schemas/day-info.schema.json",
  "title": "DayInfoDTO",
  "description": "Holiday day information transfer object — unified ABI for all platforms",
  "type": "object",
  "required": ["date", "regionCode", "calendarSystem", "isHoliday", "isOfficialHoliday", "isWorkday", "isWeekend", "isStatutoryHoliday", "isAdjustedWorkday", "holidayNames", "labels", "lunar", "solarTerm", "ganZhi", "festivals", "sourceVersion"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date in YYYY-MM-DD format" },
    "regionCode": { "type": "string", "minLength": 2, "description": "Region code (e.g. CN, CN-SH)" },
    "calendarSystem": { "type": "string", "enum": ["GREGORIAN", "CHINESE_LUNAR"], "description": "Calendar system" },
    "isHoliday": { "type": "boolean", "description": "Whether this day is a holiday (day off)" },
    "isOfficialHoliday": { "type": "boolean", "description": "Whether this day belongs to an officially announced holiday period" },
    "isWorkday": { "type": "boolean", "description": "Whether this day is a working day" },
    "isWeekend": { "type": "boolean", "description": "Whether this day falls on a default weekend" },
    "isStatutoryHoliday": { "type": "boolean", "description": "Whether this day is a statutory holiday proper" },
    "isAdjustedWorkday": { "type": "boolean", "description": "Whether this day is an adjusted workday (调休补班)" },
    "holidayNames": {
      "type": "object",
      "description": "Multi-language holiday names",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Label tags for this day"
    },
    "lunar": {
      "description": "Chinese lunar date, or null outside the supported asset range",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["year", "month", "day", "isLeapMonth", "monthName", "dayName"],
          "properties": {
            "year": { "type": "integer" },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "day": { "type": "integer", "minimum": 1, "maximum": 30 },
            "isLeapMonth": { "type": "boolean" },
            "monthName": { "type": "string" },
            "dayName": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "solarTerm": {
      "description": "Solar term on this date, or null on an ordinary date",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["index", "name"],
          "properties": {
            "index": { "type": "integer", "minimum": 0, "maximum": 23 },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "ganZhi": {
      "description": "Lunar-year heavenly stem, earthly branch, cycle name and zodiac",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["yearName", "heavenlyStem", "earthlyBranch", "zodiac"],
          "properties": {
            "yearName": { "type": "string" },
            "heavenlyStem": { "type": "string" },
            "earthlyBranch": { "type": "string" },
            "zodiac": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "festivals": {
      "type": "array",
      "description": "Traditional festivals and observances independent of day-off status",
      "items": {
        "type": "object",
        "required": ["code", "names"],
        "properties": {
          "code": { "type": "string" },
          "names": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "sourceVersion": { "type": "string", "description": "Data source version" }
  },
  "additionalProperties": false
}

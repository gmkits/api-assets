{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://holiday-platform.dev/schemas/day-info.schema.json",
  "title": "DayInfoDTO",
  "description": "Holiday day information transfer object — unified ABI for all platforms",
  "type": "object",
  "required": ["date", "regionCode", "calendarSystem", "isHoliday", "isWorkday", "isWeekend", "isStatutoryHoliday", "isAdjustedWorkday", "holidayNames", "labels", "sourceVersion", "extensions"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date in YYYY-MM-DD format" },
    "regionCode": { "type": "string", "minLength": 2, "description": "Region code (e.g. CN, CN-SH)" },
    "calendarSystem": { "type": "string", "enum": ["GREGORIAN", "CHINESE_LUNAR"], "description": "Calendar system" },
    "isHoliday": { "type": "boolean", "description": "Whether this day is a holiday (day off)" },
    "isWorkday": { "type": "boolean", "description": "Whether this day is a working day" },
    "isWeekend": { "type": "boolean", "description": "Whether this day falls on a default weekend" },
    "isStatutoryHoliday": { "type": "boolean", "description": "Whether this day is a statutory holiday proper" },
    "isAdjustedWorkday": { "type": "boolean", "description": "Whether this day is an adjusted workday (调休补班)" },
    "holidayNames": {
      "type": "object",
      "description": "Multi-language holiday names",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Label tags for this day"
    },
    "sourceVersion": { "type": "string", "description": "Data source version" },
    "extensions": { "type": "object", "description": "Extension data", "default": {} }
  },
  "additionalProperties": false
}

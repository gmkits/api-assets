{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gmkits.github.io/api-assets/schemas/api-asset.schema.json",
  "title": "API asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "contract", "runtime", "build", "container", "paths", "data", "artifacts", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "openapi" },
        "path": { "type": "string", "pattern": "^contract/.+\\.ya?ml$" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify", "build", "image", "smoke"],
      "properties": {
        "verify": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "smoke": { "type": "string", "minLength": 1 }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "port"],
      "properties": {
        "image": { "type": "string", "pattern": "^[a-z0-9._/-]+:\\$\\{version\\}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "liveness", "readiness", "metrics"],
      "properties": {
        "base": { "type": "string", "pattern": "^/" },
        "liveness": { "type": "string", "pattern": "^/" },
        "readiness": { "type": "string", "pattern": "^/" },
        "metrics": { "type": "string", "pattern": "^/" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "regions", "coverage"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "regions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,8})*$" } },
        "coverage": { "type": "object", "minProperties": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "sideEffectFree", "cacheable"],
      "properties": {
        "deterministic": { "type": "boolean" },
        "sideEffectFree": { "type": "boolean" },
        "cacheable": { "type": "boolean" }
      }
    }
  }
}
